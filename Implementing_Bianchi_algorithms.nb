Cell[TextData[{
 "We compute now the Ricci invariants ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "4af8fbd0-3a01-d14c-a521-821afa118e08"],
 " and ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "2a1c4a87-6cfb-794b-834f-7f48a2215b4a"],
 " and the 2-tensor defined by the first condition in (8)"
}], "Text",
 CellChangeTimes->{{3.931235995716455*^9, 3.931236007296078*^9}, {
  3.93123607657609*^9, 3.931236115739742*^9}, {3.931244590801071*^9, 
  3.931244604414612*^9}},ExpressionUUID->"411ceffd-9875-4d49-ad89-\
269790126664"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"CD", "=", 
   RowBox[{"CovDOfMetric", "[", "metric", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Ricci", "[", "CD", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{
    RowBox[{"R", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"R", "-", 
    RowBox[{
     FractionBox["1", "4"], "r", " ", "metric"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S2", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"S", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", "i"}], "]"}], 
       RowBox[{"S", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trS2", "=", 
   RowBox[{
    RowBox[{"S2", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S3", "=", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"S2", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "i"}], "]"}], 
      RowBox[{"S", "[", 
       RowBox[{
        RowBox[{"-", "i"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trS3", "=", 
   RowBox[{"S3", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "a"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     FractionBox["trS3", "trS2"]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{"S", "-", 
    RowBox[{
     FractionBox["1", "4"], "q", " ", "metric"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q2", "=", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "i"}], "]"}], 
      RowBox[{"Q", "[", 
       RowBox[{
        RowBox[{"-", "i"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q2", "+", 
   RowBox[{"q", " ", "Q"}]}], "//", "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.917417044339543*^9, 3.917417107850323*^9}, {
