Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalSigma]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", 
          RowBox[{"P", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", 
            RowBox[{"-", "m"}]}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "[", 
          RowBox[{"P", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "m"}]}], "]"}], "]"}]}], ")"}], 
       RowBox[{"P", "[", 
        RowBox[{"m", ",", 
         RowBox[{"-", "l"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "l"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptX]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
