812b9e4f8ebc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"P0", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"metric", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", 
           RowBox[{"-", "b"}]}], "]"}], "-", 
         RowBox[{
          RowBox[{"U11", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "i"}]}], "]"}], 
          RowBox[{"U11", "[", 
           RowBox[{"i", ",", 
            RowBox[{"-", "b"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"U22", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "i"}]}], "]"}], 
          RowBox[{"U22", "[", 
           RowBox[{"i", ",", 
            RowBox[{"-", "b"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"U33", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "i"}]}], "]"}], 
          RowBox[{"U33", "[", 
           RowBox[{"i", ",", 
            RowBox[{"-", "b"}]}], "]"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w1", "+", "w4", "+", "w2"}], ")"}], "/", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"2", 
           SuperscriptBox["kk", "2"]}]}]]}], 
       RowBox[{
        SqrtBox["2"], "\[ScriptA]"}]], ")"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
