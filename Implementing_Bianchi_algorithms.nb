       FractionBox["1", "2"], "aa", " ", "xx"}], "-", 
      RowBox[{
       FractionBox["1", "3"], "bb"}]}], "==", "0"}], ",", "xx"}], "]"}], "//",
   "FullSimplify"}]], "Input",
