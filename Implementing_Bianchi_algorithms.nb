          RowBox[{"linelement", ",", 
           RowBox[{"dy", " ", "dz"}]}], "]"}], "/", "2"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dz", " ", "dt"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dz", " ", "dx"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
