      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Delta]\[Sigma]", "=", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Alpha]\[Sigma]", "3"], "-", 
