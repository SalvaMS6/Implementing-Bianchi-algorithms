  3.931408752774864*^9, 
  3.9314088070177326`*^9}},ExpressionUUID->"66d4a5d7-8a1c-e246-bbf8-\
81f9beb2480d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"\[ScriptA]", "\[Element]", "Reals"}], "&&", 
    RowBox[{
     RowBox[{"y", "[", "]"}], "\[Element]", "Reals"}], "&&", 
    RowBox[{"s", "\[Element]", "Reals"}], "&&", 
    RowBox[{"s", "!=", "0"}], "&&", 
    RowBox[{
     SuperscriptBox["s", "2"], "<", 
     RowBox[{"1", "/", "4"}]}]}]}], ";"}]], "Input",
