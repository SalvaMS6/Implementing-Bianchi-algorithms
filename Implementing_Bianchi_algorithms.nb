Cell["\<\
Now, let us define the manifold, the chart, the scalar metric functions and \
the metric (46) of the general expression of the metrics admitting a \
three-dimensional group of isometries of Bianchi type I\
\>", "Text",
 CellChangeTimes->{{3.930892425862013*^9, 3.930892433098921*^9}, {
  3.930892465227888*^9, 3.930892523359791*^9}, {3.930892772874796*^9, 
  3.930892788165512*^9}, {3.9315186217849064`*^9, 
  3.9315186245343037`*^9}},ExpressionUUID->"e7472292-11f0-ac4f-960b-\
dbc404e9033a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "4", ",", 
    RowBox[{"IndexRange", "[", 
     RowBox[{"a", ",", "n"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"chart", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"x", "[", "]"}], ",", 
      RowBox[{"y", "[", "]"}], ",", 
      RowBox[{"z", "[", "]"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "l1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "l2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "l3", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"l1", "[", 
      RowBox[{"t", "[", "]"}], "]"}], "\[Element]", "Reals"}], "&&", 
    RowBox[{
     RowBox[{"l2", "[", 
      RowBox[{"t", "[", "]"}], "]"}], "\[Element]", "Reals"}], "&&", 
    RowBox[{
     RowBox[{"l3", "[", 
      RowBox[{"t", "[", "]"}], "]"}], "\[Element]", "Reals"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metricMatrix", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      SuperscriptBox[
       RowBox[{"l1", "[", 
        RowBox[{"t", "[", "]"}], "]"}], "2"], ",", 
      SuperscriptBox[
       RowBox[{"l2", "[", 
        RowBox[{"t", "[", "]"}], "]"}], "2"], ",", 
      SuperscriptBox[
       RowBox[{"l3", "[", 
        RowBox[{"t", "[", "]"}], "]"}], "2"]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metric", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{"metricMatrix", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "chart"}], ",", 
       RowBox[{"-", "chart"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetCMetric", "[", 
   RowBox[{"metric", ",", "chart", ",", 
    RowBox[{"SignatureOfMetric", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1", ",", "0"}], "}"}]}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.915246209030916*^9, 3.9152462759776225`*^9}, 
   3.915246307076542*^9, {3.930892557296896*^9, 3.93089257032023*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"01bf89e9-5c27-b446-b0e9-b69bf34269d3"],

