Cell["\<\
The first condition is fulfilled. Let us check the second one. Now, \[Omega]1 \
is the time-like vector, so:\
\>", "Text",
 CellChangeTimes->{{3.9313259793444023`*^9, 3.931325985234478*^9}, {
  3.9313296087889576`*^9, 
  3.931329647751997*^9}},ExpressionUUID->"d2be4b39-109f-d74e-ba76-\
bf7ab2838c6e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"\[Omega]1", ",", "dt"}], "]"}], ",", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"\[Omega]1", ",", "dx"}], "]"}], ",", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"\[Omega]1", ",", "dy"}], "]"}], ",", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"\[Omega]1", ",", "dz"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"-", "chart"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"q", " ", 
    RowBox[{"Q", "[", 
     RowBox[{
      RowBox[{"-", "i"}], ",", 
      RowBox[{"-", "j"}]}], "]"}], 
    RowBox[{"v", "[", "i", "]"}], 
    RowBox[{"v", "[", "j", "]"}]}], "//", "FullSimplify"}]}]}], "Input",
