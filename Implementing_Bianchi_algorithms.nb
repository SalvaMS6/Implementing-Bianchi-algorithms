        RowBox[{"Coefficient", "[", 
         RowBox[{"linelement", ",", 
          SuperscriptBox["dz", "2"]}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
