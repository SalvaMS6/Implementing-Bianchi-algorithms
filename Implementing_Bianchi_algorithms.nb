Cell[TextData[{
 "Next, we need arbitrary bivectors to project them and get the canonical \
bivectors. We will build them out of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Omega]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4bb36de5-d668-294a-9684-64ac475669cd"],
 " basis"
}], "Text",
