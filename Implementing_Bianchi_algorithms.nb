Cell[TextData[{
 "Any way, with this, the connection tensor ",
 StyleBox["H",
  FontSlant->"Italic"],
 " can be obtained as (1):"
}], "Text",
 CellChangeTimes->{{3.9314119083137417`*^9, 
  3.931411939497448*^9}},ExpressionUUID->"6d013d48-b57f-2849-9f30-\
f7a75a325ae8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"CD", "[", "a", "]"}], "[", 
              RowBox[{"e0", "[", "b", "]"}], "]"}], " ", 
             RowBox[{"e0", "[", "c", "]"}]}], "-", 
            RowBox[{
             RowBox[{
              RowBox[{"CD", "[", "a", "]"}], "[", 
              RowBox[{"e0", "[", "c", "]"}], "]"}], " ", 
             RowBox[{"e0", "[", "b", "]"}]}]}], ")"}]}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e1", "[", "b", "]"}], "]"}], " ", 
            RowBox[{"e1", "[", "c", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e1", "[", "c", "]"}], "]"}], " ", 
            RowBox[{"e1", "[", "b", "]"}]}]}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e2", "[", "b", "]"}], "]"}], " ", 
            RowBox[{"e2", "[", "c", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e2", "[", "c", "]"}], "]"}], " ", 
            RowBox[{"e2", "[", "b", "]"}]}]}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e3", "[", "b", "]"}], "]"}], " ", 
            RowBox[{"e3", "[", "c", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "a", "]"}], "[", 
             RowBox[{"e3", "[", "c", "]"}], "]"}], " ", 
            RowBox[{"e3", "[", "b", "]"}]}]}], ")"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}], "//", 
    "FullSimplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9314119694852924`*^9, 3.931412084789917*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"69a39f8b-7cf3-434f-9d8b-84e2852a0e6b"],

Cell[TextData[{
 "Now that we have the connection tensor H, we can apply the algorithm in \
Fig. 4. We start by using the ",
 StyleBox["xIdeal",
  FontSlant->"Italic"],
 " function that computes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", 
    RowBox[{"[", "1", "]"}]], TraditionalForm]],ExpressionUUID->
  "e0e9a763-0e0f-a748-a8f0-a5abe4eb6692"],
 ":"
}], "Text",
 CellChangeTimes->{{3.931331628989598*^9, 
  3.9313317040322895`*^9}},ExpressionUUID->"6ecc0b8a-9bad-7846-8738-\
704758cac039"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{"-", "a"}], "]"}], "[", 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", "i"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "c"}], ",", "j"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "d"}], ",", "k"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "k"}]}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{3.931331714863884*^9},
 CellLabel->
  "In[161]:=",ExpressionUUID->"f24d09e0-5cd1-9e43-be1c-885394ee2164"],

Cell[BoxData["Zero"], "Output",
 CellChangeTimes->{3.931613322754118*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"dbebedcd-f36d-e04f-93b1-cef931fd8f2f"]
}, Open  ]],

Cell[TextData[{
 "It vanishes, so we have a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "4"], "/", 
    SubscriptBox["O", "4"]}], TraditionalForm]],ExpressionUUID->
  "ec10e68a-a83d-1940-9898-af22d36f413e"],
 ". We could have also obtained this result by using the xIdeal function that \
gives the dimension of the isometry group of a metric if its associated \
connection tensor is known"
}], "Text",
 CellChangeTimes->{{3.931331946258438*^9, 3.931331982385008*^9}, {
  3.9313320250449677`*^9, 
  3.931332092487004*^9}},ExpressionUUID->"55953e94-9b6b-0b49-804a-\
9623361814b2"],

