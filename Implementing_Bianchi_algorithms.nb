Cell[TextData[{
 "This computation can actually be performed faster by hand using the \
non-coordinate frame of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Omega]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c294f4f1-5411-0b49-bfb9-d807075a2ebc"],
 " and one gets the same result "
}], "Text",
 CellChangeTimes->{{3.9314102336055946`*^9, 
  3.931410319828247*^9}},ExpressionUUID->"c52ba311-13cf-5c46-892e-\
1deae468bb21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"e0", "=", 
   RowBox[{"\[ScriptA]", 
    SqrtBox["2"], "w1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{
    RowBox[{"\[ScriptA]", " ", "w4"}], "+", 
    RowBox[{"\[ScriptA]", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"2", 
        SuperscriptBox["s", "2"]}]}]], "w1"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e2", "=", 
   RowBox[{"\[ScriptA]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "+", "s"}]], "w2"}], "+", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", "s"}]], "w3"}]}], ")"}], "/", 
     SqrtBox["2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e3", "=", 
   RowBox[{"\[ScriptA]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "+", "s"}]], "w2"}], "-", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", "s"}]], "w3"}]}], ")"}], "/", 
     SqrtBox["2"]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.921033776069786*^9, 3.9210338943270435`*^9}, {
  3.921660070109606*^9, 3.921660085056881*^9}, {3.921663621853267*^9, 
