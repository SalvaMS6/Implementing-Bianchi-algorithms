Cell[TextData[{
 "Now that we have checked that our metric is a perfect fluid solution, let \
us determine its Petrov Type by using the ",
 StyleBox["xIdeal",
  FontSlant->"Italic"],
 " function that implements the algorithm in Fig. 1:"
}], "Text",
 CellChangeTimes->{{3.9313317593352833`*^9, 
  3.931331824977211*^9}},ExpressionUUID->"e86ae433-d395-c34a-9589-\
151c7e904cb5"],

