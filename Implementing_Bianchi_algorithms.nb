Cell[TextData[{
 "We compute now the Ricci invariants ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15c0991a-0645-9c44-8396-d8310fa9ecb8"],
 " and ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55fadd1e-7f70-d346-987e-1238854d19aa"],
 " and check the perfect fluid conditions"
}], "Text",
 CellChangeTimes->{{3.9312359957164555`*^9, 3.9312360072960777`*^9}, {
  3.93123607657609*^9, 
  3.9312361157397423`*^9}},ExpressionUUID->"4610b935-14ba-2349-b62c-\
ceeb7e59ffca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CD", "=", 
   RowBox[{"CovDOfMetric", "[", "metric", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Ricci", "[", "CD", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{
    RowBox[{"R", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"R", "-", 
    RowBox[{
     FractionBox["1", "4"], "r", " ", "metric"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S2", "=", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"S", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "i"}], "]"}], 
      RowBox[{"S", "[", 
       RowBox[{
        RowBox[{"-", "i"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trS2", "=", 
   RowBox[{"S2", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "a"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S3", "=", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"S2", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "i"}], "]"}], 
      RowBox[{"S", "[", 
       RowBox[{
        RowBox[{"-", "i"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trS3", "=", 
   RowBox[{"S3", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "a"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     FractionBox["trS3", "trS2"]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{"S", "-", 
    RowBox[{
     FractionBox["1", "4"], "q", " ", "metric"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q2", "=", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "i"}], "]"}], 
      RowBox[{"Q", "[", 
       RowBox[{
        RowBox[{"-", "i"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.917417044339543*^9, 3.917417107850323*^9}, {
  3.931236233588457*^9, 3.931236251292193*^9}, {3.931237873880932*^9, 
