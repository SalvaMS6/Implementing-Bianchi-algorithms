Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalG]", "=", 
   RowBox[{
    RowBox[{
    "xAct`xIdeal`Private`metricConcomitant", "[", "\"\<G2Form\>\"", "]"}], 
    "[", 
    RowBox[{"metric", ",", 
     RowBox[{"Verbose", "->", "False"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalW]", "=", 
   RowBox[{
    RowBox[{
    "xAct`xIdeal`Private`weylConcomitant", "[", "\"\<WeylSelfDual\>\"", "]"}],
     "[", 
    RowBox[{"metric", ",", 
     RowBox[{"Verbose", "->", "False"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P1", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["2", "3"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", "\[Psi]"], "\[ScriptCapitalW]"}], "-", 
            "\[ScriptCapitalG]"}], ")"}]}], ")"}], "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}], ",", 
