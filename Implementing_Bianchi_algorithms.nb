 CellLabel->"In[95]:=",ExpressionUUID->"28a83c08-ad63-c144-a544-44569a2cf571"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"linelement", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], 
     SuperscriptBox["\[Omega]3", "2"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "s"}], ")"}], 
     SuperscriptBox["\[Omega]2", "2"]}], "-", 
    RowBox[{"2", 
     SuperscriptBox["\[Omega]1", "2"]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"dt", "+", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"2", 
           SuperscriptBox["s", "2"]}]}]], "\[Omega]1"}]}], ")"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"linelement", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{"linelement", ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["dt", "2"], ",", 
       SuperscriptBox["dx", "2"], ",", 
       SuperscriptBox["dy", "2"], ",", 
       SuperscriptBox["dz", "2"], ",", 
       RowBox[{"dx", " ", "dz"}], ",", 
       RowBox[{"dy", " ", "dz"}]}], "}"}], ",", "Simplify"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metricMatrix", "=", "\[IndentingNewLine]", 
   RowBox[{
    SuperscriptBox["\[ScriptA]", "2"], 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"linelement", ",", 
          SuperscriptBox["dt", "2"]}], "]"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dt", " ", "dx"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dt", " ", "dy"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dt", " ", "dz"}]}], "]"}], "/", "2"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dx", " ", "dt"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"linelement", ",", 
          SuperscriptBox["dx", "2"]}], "]"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dx", " ", "dy"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dx", " ", "dz"}]}], "]"}], "/", "2"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dy", " ", "dt"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"linelement", ",", 
           RowBox[{"dy", " ", "dx"}]}], "]"}], "/", "2"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"linelement", ",", 
          SuperscriptBox["dy", "2"]}], "]"}], ",", 
        RowBox[{
