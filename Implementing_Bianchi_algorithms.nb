  3.931332018896908*^9},ExpressionUUID->"46f32577-8d91-fc4d-9634-\
b2e9cab16e4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"trH", "=", 
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}]}], "]"}], "//", "Simplify"}]}]], "Input",
