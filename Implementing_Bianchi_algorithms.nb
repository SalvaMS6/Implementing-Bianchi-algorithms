    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x", "[", "]"}], "]"}], 
     RowBox[{"Cosh", "[", 
      RowBox[{"y", "[", "]"}], "]"}], "dz"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x", "[", "]"}], "]"}], "dy"}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"x", "[", "]"}], "]"}], 
     RowBox[{"Cosh", "[", 
      RowBox[{"y", "[", "]"}], "]"}], "dz"}]}]}], 
