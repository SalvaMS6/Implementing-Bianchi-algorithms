 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "a"}], "]"}], "[", 
        RowBox[{"\[CapitalSigma]", "[", 
         RowBox[{"b", ",", 
          RowBox[{"-", "c"}], ",", 
          RowBox[{"-", "d"}]}], "]"}], "]"}], 
       RowBox[{"\[CapitalSigma]", "[", 
        RowBox[{"c", ",", "e", ",", 
         RowBox[{"-", "f"}]}], "]"}], 
       RowBox[{"P", "[", 
        RowBox[{"d", ",", "f"}], "]"}], 
       RowBox[{
        RowBox[{"epsilon", "[", "metric", "]"}], "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "e"}], ",", 
         RowBox[{"-", "g"}], ",", 
         RowBox[{"-", "h"}]}], "]"}], 
       RowBox[{"KK", "[", 
        RowBox[{"g", ",", "i"}], "]"}], 
       RowBox[{
        RowBox[{"epsilon", "[", "metric", "]"}], "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "k"}], ",", 
         RowBox[{"-", "l"}]}], "]"}], 
       RowBox[{"P", "[", 
        RowBox[{"h", ",", "l"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "j"}], ",", 
        RowBox[{"-", "k"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalI]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", 
          RowBox[{"P", "[", 
           RowBox[{"i", ",", 
            RowBox[{"-", "b"}]}], "]"}], "]"}]}], 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"-", "c"}], ",", 
          RowBox[{"-", "i"}]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"P", "[", 
          RowBox[{"i", ",", 
           RowBox[{"-", "c"}]}], "]"}], "]"}], 
        RowBox[{"P", "[", 
         RowBox[{
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "i"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{
    RowBox[{"\[ScriptCapitalI]", "-", "J"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.912071058624603*^9, 3.9120711017949624`*^9}, {
   3.9120711432939663`*^9, 3.912071165228163*^9}, {3.9120712021702595`*^9, 
   3.912071239794093*^9}, {3.912071516730802*^9, 3.9120715641424975`*^9}, {
   3.912071595044758*^9, 3.912071607479974*^9}, {3.912071682544801*^9, 
   3.9120717094023714`*^9}, {3.9120717891976857`*^9, 3.9120721173724427`*^9}, 
   3.912072191980243*^9},
 CellLabel->
  "In[190]:=",ExpressionUUID->"2b3647f8-a732-2144-899d-73eb5bf0dd68"],

Cell[TextData[{
 "Now that we have the connection tensor H, we can apply the algorithm in \
Fig. 4. We start by using the ",
 StyleBox["xIdeal",
  FontSlant->"Italic"],
 " function that computes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", 
    RowBox[{"[", "1", "]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b120dee-fd7e-474a-8321-20cf85796d8b"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9313316289895973`*^9, 
  3.9313317040322895`*^9}},ExpressionUUID->"e0a0bd59-bc63-1d42-9387-\
dce0f69c8fc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"C1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"HeadOfTensor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{"-", "a"}], "]"}], "[", 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", "i"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "c"}], ",", "j"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "d"}], ",", "k"}], "]"}], 
       RowBox[{"H", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "k"}]}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{3.931331714863884*^9},
 CellLabel->
  "In[194]:=",ExpressionUUID->"e58d8de9-2bd8-bd43-834c-bf3d3f98b34c"],

Cell[BoxData["Zero"], "Output",
 CellChangeTimes->{3.931331715923609*^9},
 CellLabel->
  "Out[194]=",ExpressionUUID->"82b5f912-163f-8744-bb90-05c8bed57dbe"]
}, Open  ]],

Cell[TextData[{
 "It vanishes, so we have a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "4"], "/", 
    SubscriptBox["O", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4955c35-0079-824c-9941-13ef8263bf4c"],
 ". We could have also obtained this result by using the xIdeal function that \
gives the dimension of the isometry group of a metric if its associated \
connection tensor is known"
}], "Text",
 CellChangeTimes->{{3.931331946258438*^9, 3.931331982385008*^9}, {
  3.9313320250449677`*^9, 
  3.9313320924870033`*^9}},ExpressionUUID->"010f4387-3766-e84a-92f5-\
6487d77b7803"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsometryGroupDimension", "[", 
  RowBox[{"metric", ",", "H", ",", 
   RowBox[{"Verbose", "->", "False"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.931332108567545*^9, 3.931332113096874*^9}},
 CellLabel->
  "In[195]:=",ExpressionUUID->"4d115a63-4e1b-0748-bd5d-f77c60bf602b"],

Cell[BoxData["\<\"\\!\\(\\*SubscriptBox[\\(G\\), \\(4\\)]\\)\"\>"], "Print",
 CellChangeTimes->{3.9313321140019016`*^9},
 CellLabel->
  "During evaluation of \
In[195]:=",ExpressionUUID->"a0443b8c-3a28-da42-902a-4bbde08a650a"]
}, Open  ]],

Cell[TextData[{
 "Now we need to check the trace of ",
 StyleBox["H",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{
  3.931332018896908*^9},ExpressionUUID->"ac18bc05-3391-174d-978a-\
14164f5cdeca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"trH", "=", 
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"a", ",", 
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}]}], "]"}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.916215354699214*^9, 3.91621536488242*^9}, {
  3.9313321256445847`*^9, 3.931332126929762*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"2ae7ece6-16f1-8544-ab94-1536f29fff36"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.931332128809065*^9},
 CellLabel->
  "Out[196]=",ExpressionUUID->"d657b0e4-b774-5441-9549-f3916e493704"]
}, Open  ]],

Cell[TextData[{
 "It vanishes, so the group is unimodular. However, ",
 StyleBox["q",
  FontSlant->"Italic"],
 " is positive but ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is not"
}], "Text",
 CellChangeTimes->{{3.9313321600813656`*^9, 3.9313321696567383`*^9}, {
  3.9313322258632984`*^9, 
  3.9313322553407993`*^9}},ExpressionUUID->"d760368c-5a1d-e84e-8c73-\
70caf05f65ee"],

Cell[CellGroupData[{

Cell[BoxData["r"], "Input",
 CellChangeTimes->{3.9313322476941757`*^9},
 CellLabel->
  "In[197]:=",ExpressionUUID->"e4ed360b-7e89-e944-95fe-7b6fdbde5eeb"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["1", 
   SuperscriptBox[
    InterpretationBox[
     StyleBox["a",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`\[ScriptA],
     Editable->False], "2"]]}]], "Output",
 CellChangeTimes->{3.9313322479293213`*^9},
 CellLabel->
  "Out[197]=",ExpressionUUID->"4a45ee50-a43c-2547-b892-1b3872455da4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["q"], "Input",
 CellChangeTimes->{3.931332249032486*^9},
 CellLabel->
  "In[198]:=",ExpressionUUID->"ec5c3c38-70a2-2147-8484-e7e1721c6597"],

Cell[BoxData[
 FractionBox["1", 
  SuperscriptBox[
   InterpretationBox[
    StyleBox["a",
     ShowAutoStyles->False,
     AutoSpacing->False],
    $CellContext`\[ScriptA],
    Editable->False], "2"]]], "Output",
 CellChangeTimes->{3.931332249283926*^9},
 CellLabel->
  "Out[198]=",ExpressionUUID->"3dc01e27-4123-c646-9bb5-b99aaed51f91"]
}, Open  ]],

Cell["So this is not a spatially-homogeneous solution.", "Text",
 CellChangeTimes->{{3.931332267899351*^9, 3.9313322683681545`*^9}, {
  3.931332409930996*^9, 
  3.9313324436297474`*^9}},ExpressionUUID->"de85e3d6-fbd6-444f-b601-\
78151390fa0b"]
}, Open  ]]
