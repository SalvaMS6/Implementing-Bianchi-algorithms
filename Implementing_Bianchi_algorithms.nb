         RowBox[{
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "l"}], ",", 
          RowBox[{"-", "m"}]}], "]"}]}], 
       RowBox[{"\[CapitalSigma]", "[", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "l", ",", "m"}], "]"}], 
       RowBox[{"\[CapitalSigma]", "[", 
        RowBox[{"b", ",", "c", ",", "a"}], "]"}]}], ",", 
      RowBox[{"{", "a", "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[CapitalSigma]", "[", 
