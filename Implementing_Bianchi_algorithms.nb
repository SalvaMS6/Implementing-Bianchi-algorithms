       RowBox[{"Coefficient", "[", 
        RowBox[{"\[Omega]1", ",", "dz"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"-", "chart"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
