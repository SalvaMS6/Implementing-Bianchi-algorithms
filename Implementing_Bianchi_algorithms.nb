         RowBox[{"-", "i"}]}], "]"}], 
       RowBox[{"vv", "[", "i", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"-", "a"}], "}"}]}], "]"}], "//", "FullSimplify"}]}], 
