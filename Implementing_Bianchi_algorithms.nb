 CellLabel->
  "In[118]:=",ExpressionUUID->"9d50eec2-e0c8-d94c-9ec1-9fd13d0afcb7"],

Cell["\<\
Next, we solve the characteristic equation to get the self-dual Weyl \
eigenvalues\
\>", "Text",
 CellChangeTimes->{{3.931408122167013*^9, 
  3.9314081410716*^9}},ExpressionUUID->"85b21f14-fa4f-3d40-a311-94b597f716d3"],

Cell[CellGroupData[{

