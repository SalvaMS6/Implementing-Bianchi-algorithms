}, Open  ]],

Cell[TextData[{
 "Since this metric is of Petrov Type D, in order to obtain its connection \
tensor ",
 StyleBox["H",
  FontSlant->"Italic"],
 " we need to follow the algorithm in Fig. 3. Let us do it, step by step, \
explicitly. We start by obtaining ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85588d25-1078-084d-8d87-31e18f8152ab"],
 ":"
}], "Text",
 CellChangeTimes->{{3.931330499607807*^9, 3.9313305710374336`*^9}, {
  3.931330618578705*^9, 
  3.9313306380989*^9}},ExpressionUUID->"0e40216f-b4d5-2f4b-8ab2-bda62a84820a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"W", "=", 
   RowBox[{"Weyl", "[", "CD", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Q", "/", "q"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"E1", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "j"}]}], "]"}], 
       RowBox[{"P", "[", 
        RowBox[{"i", ",", "j"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"E12", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"E1", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", "i"}], "]"}], 
       RowBox[{"E1", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trE12", "=", 
   RowBox[{
    RowBox[{"E12", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"E13", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"E12", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", "i"}], "]"}], 
       RowBox[{"E1", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trE13", "=", 
   RowBox[{
    RowBox[{"E13", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "a"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Delta]1", "=", 
  RowBox[{
   RowBox[{
    SuperscriptBox["trE12", "3"], "-", 
    RowBox[{"6", 
     SuperscriptBox["trE13", "2"]}]}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.912063405158498*^9, 3.912063585773746*^9}, {
  3.931330663878742*^9, 3.931330673201952*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"ac0975f9-d592-ff4b-9fbf-c42378005517"],

