       RowBox[{"v1", "[", 
        RowBox[{"-", "i"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"-", "a"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "6"]}], 
       RowBox[{
        RowBox[{"epsilon", "[", "metric", "]"}], "[", 
