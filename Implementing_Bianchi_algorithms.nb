  "In[162]:=",ExpressionUUID->"d02e97ca-8445-9a42-99e5-295ff86df79e"],

Cell[BoxData["\<\"\\!\\(\\*SubscriptBox[\\(G\\), \\(4\\)]\\)\"\>"], "Print",
