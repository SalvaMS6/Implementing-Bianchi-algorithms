       Scaled[0.02], 
       Scaled[0.02]}, {
       Scaled[0.05], 
       Scaled[0.05]}},
    Ticks->{Automatic, Automatic}]}], "}"}]], "Output",
 CellChangeTimes->{3.9313297590701942`*^9, 3.931329807076594*^9, 
  3.931333581201458*^9, 3.9314039084420834`*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"c91eddef-052f-9046-a24b-8d4b2d06aaa0"]
}, Open  ]],

Cell["\<\
The second condition is also fulfilled. Therefore, this is a perfect fluid \
solution.\
\>", "Text",
 CellChangeTimes->{{3.931329834620262*^9, 3.9313298451129875`*^9}, {
  3.931333766995756*^9, 
  3.931333775321846*^9}},ExpressionUUID->"200439e7-8c7a-1c40-b1d6-\
b86cd817f83a"],

Cell[TextData[{
 "Now that we have checked that our metric is a perfect fluid solution, let \
us determine its Petrov Type by using the ",
 StyleBox["xIdeal",
  FontSlant->"Italic"],
 " function that implements the algorithm in Fig. 1 (actually, we use the \
analog method with the Petrov Matrix since in this case it is faster, see \
https://arxiv.org/abs/2103.06158):"
}], "Text",
 CellChangeTimes->{{3.931331759335284*^9, 3.931331824977211*^9}, {
   3.931407237074936*^9, 3.9314072724682407`*^9}, 3.9314073233290644`*^9, {
   3.931519726483244*^9, 
   3.9315197327402096`*^9}},ExpressionUUID->"5fc730f7-4c9c-0444-923f-\
379fd12f52f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptV]", "=", 
   RowBox[{
    SqrtBox["2"], "\[ScriptA]", " ", "v"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PetrovType", "[", 
  RowBox[{"metric", ",", 
   RowBox[{"Verbose", "->", "False"}], ",", 
   RowBox[{"Method", "->", "\"\<PetrovMatrix\>\""}], ",", 
   RowBox[{"\"\<Observer\>\"", "->", "\[ScriptV]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.910346313965946*^9, 3.910346323230034*^9}, {
  3.930892934991476*^9, 3.9308929400683193`*^9}, {3.931406588301279*^9, 
  3.931406627865364*^9}, {3.9314071381668167`*^9, 3.931407144533333*^9}, {
  3.9314077312607727`*^9, 3.9314077890415134`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"f332e23f-b004-2144-a910-43c7b42f7a56"],

Cell[BoxData["\<\"Type I\"\>"], "Output",
 CellChangeTimes->{3.9314072042459126`*^9, 3.931407746682635*^9, 
  3.931407793269638*^9, 3.9315198444228*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"97ba5aa8-ce5b-804a-b0ec-a4c88d764391"]
}, Open  ]],

Cell[TextData[{
 "In this case, we will obtain the connection tensor ",
 StyleBox["H",
  FontSlant->"Italic"],
 " by obtaining the Weyl principal frame as indicated in ",
 ButtonBox["Ferrando J J, Morales J A and S \.13aez J A 2001 Class. Quantum \
Grav. 18 4939",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://iopscience.iop.org/article/10.1088/0264-9381/18/22/315"], 
    None},
  ButtonNote->
   "https://iopscience.iop.org/article/10.1088/0264-9381/18/22/315"],
 " and using Eq. (1). Let us do it step by step."
}], "Text",
 CellChangeTimes->{{3.9314044012908096`*^9, 3.9314045043194904`*^9}, {
  3.9314045343308105`*^9, 3.9314045450184116`*^9}, {3.9314064147514057`*^9, 
  3.9314064276246567`*^9}},ExpressionUUID->"c6bb9081-1b08-cf41-9925-\
9ac1fe3cf8e7"],

Cell["\<\
First, we get the necessary Weyl concomitants to write the characteristic \
equation\
\>", "Text",
 CellChangeTimes->{{3.931407488386572*^9, 3.931407526527151*^9}, {
  3.9314075930368366`*^9, 
  3.9314076222283*^9}},ExpressionUUID->"3ca8738d-c113-ec4c-843a-59c80764d5a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"WeylCD", "=", 
   RowBox[{
    RowBox[{"Weyl", "[", "CD", "]"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilonmetric", "=", 
   RowBox[{"epsilon", "[", "metric", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WeylDual", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"epsilonmetric", "[", 
        RowBox[{
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}], ",", 
         RowBox[{"-", "e"}], ",", 
         RowBox[{"-", "f"}]}], "]"}], 
       RowBox[{"WeylCD", "[", 
        RowBox[{"e", ",", "f", ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}], ",", 
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalW]", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"WeylCD", "-", 
       RowBox[{"I", "*", " ", "WeylDual"}]}], ")"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalQ]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"\[ScriptV]", "[", "a", "]"}], 
       RowBox[{"\[ScriptV]", "[", "c", "]"}], 
       RowBox[{"\[ScriptCapitalW]", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "d"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalQ]2", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[ScriptCapitalQ]", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}]}], "]"}], 
       RowBox[{"\[ScriptCapitalQ]", "[", 
        RowBox[{"b", ",", 
         RowBox[{"-", "c"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "c"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalQ]3", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[ScriptCapitalQ]2", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "c"}]}], "]"}], 
       RowBox[{"\[ScriptCapitalQ]", "[", 
        RowBox[{"c", ",", 
         RowBox[{"-", "d"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "d"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{
    RowBox[{"\[ScriptCapitalQ]2", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", "a"}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bb", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[ScriptCapitalQ]3", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", "a"}], "]"}]}], "//", "FullSimplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.920086284358488*^9, 3.9200863127799816`*^9}, {
  3.92045172448234*^9, 3.920451774472925*^9}, {3.92173601424893*^9, 
  3.9217360203007755`*^9}, {3.921736057507588*^9, 3.921736078662848*^9}, {
  3.931407713624161*^9, 3.93140771412624*^9}, {3.931407798089964*^9, 
