Cell["\<\
Now, we construct the connection tensor of type I (as indicated in Prop. 4)\
\>", "Text",
 CellChangeTimes->{{3.930892846213724*^9, 3.930892924856491*^9}, {
  3.9312339343642244`*^9, 3.931233961776451*^9}, {3.931518768915848*^9, 
  3.931518775174635*^9}},ExpressionUUID->"ee55af67-2f88-204f-af23-\
6a1e99ba55b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CD", "=", 
   RowBox[{"CovDOfMetric", "[", "metric", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"WeylCD", "=", 
   RowBox[{
    RowBox[{"Weyl", "[", "CD", "]"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilonmetric", "=", 
   RowBox[{"epsilon", "[", "metric", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WeylDual", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"epsilonmetric", "[", 
        RowBox[{
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}], ",", 
         RowBox[{"-", "e"}], ",", 
         RowBox[{"-", "f"}]}], "]"}], 
       RowBox[{"WeylCD", "[", 
        RowBox[{"e", ",", "f", ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}], ",", 
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalW]", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"WeylCD", "-", 
       RowBox[{"I", "*", " ", "WeylDual"}]}], ")"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalW]2", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"\[ScriptCapitalW]", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", "i", ",", "j"}], "]"}], 
       RowBox[{"\[ScriptCapitalW]", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalW]3", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"\[ScriptCapitalW]2", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", "i", ",", "j"}], "]"}], 
       RowBox[{"\[ScriptCapitalW]", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[ScriptCapitalW]2", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", "a", ",", "b"}], "]"}]}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bb", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[ScriptCapitalW]3", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", "a", ",", "b"}], "]"}]}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["aa", "3"], "-", 
     RowBox[{"6", 
      SuperscriptBox["bb", "2"]}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalX]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"\[ScriptCapitalW]", "[", 
          RowBox[{
           RowBox[{"-", "b"}], ",", 
           RowBox[{"-", "i"}], ",", 
           RowBox[{"-", "j"}], ",", 
           RowBox[{"-", "k"}]}], "]"}], "]"}], ")"}], 
       RowBox[{"\[ScriptCapitalW]", "[", 
        RowBox[{"j", ",", "k", ",", "i", ",", 
         RowBox[{"-", "c"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalG]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"epsilonmetric", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "b"}], ",", 
            RowBox[{"-", "c"}], ",", 
            RowBox[{"-", "d"}]}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"metric", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "c"}]}], "]"}], 
          RowBox[{"metric", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", 
            RowBox[{"-", "d"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metric", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "d"}]}], "]"}], 
          RowBox[{"metric", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", 
            RowBox[{"-", "c"}]}], "]"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalY]", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "\[CapitalDelta]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "aa", " ", "\[ScriptCapitalW]2"}], "+", 
       RowBox[{"6", " ", "bb", " ", "\[ScriptCapitalW]"}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox["aa", "2"], "\[ScriptCapitalG]"}]}], ")"}]}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", "=", 
   RowBox[{
    RowBox[{"HeadOfTensor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"\[ScriptCapitalX]", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}]}], "]"}], 
       RowBox[{"\[ScriptCapitalY]", "[", 
        RowBox[{"i", ",", "j", ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}]}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[ScriptCapitalH]", "+", 
      RowBox[{"Dagger", "[", "\[ScriptCapitalH]", "]"}]}], ")"}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9156009027140627`*^9, 3.915600927768938*^9}, 
   3.93123034184496*^9, 3.931231500346619*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"12fec1a8-4b72-0f40-a4be-813d95f980ac"],

