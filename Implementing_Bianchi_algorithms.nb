Cell[BoxData[{
 RowBox[{
  RowBox[{"linelement", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], 
     SuperscriptBox["\[Omega]1", "2"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "s"}], ")"}], 
     SuperscriptBox["\[Omega]2", "2"]}], "-", 
    RowBox[{"2", 
     SuperscriptBox["\[Omega]3", "2"]}], "+", 
    SuperscriptBox["dt", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"linelement", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{"linelement", ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["dt", "2"], ",", 
       SuperscriptBox["dx", "2"], ",", 
       SuperscriptBox["dy", "2"], ",", 
       SuperscriptBox["dz", "2"], ",", 
       RowBox[{"dx", " ", "dz"}], ",", 
       RowBox[{"dy", " ", "dz"}]}], "}"}], ",", "Simplify"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metricMatrix", "=", "\[IndentingNewLine]", 
