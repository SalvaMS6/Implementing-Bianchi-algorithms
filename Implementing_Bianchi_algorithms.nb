Cell[BoxData[{
 RowBox[{
  RowBox[{"KK", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Delta]\[Sigma]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "\[Alpha]\[Sigma]", "  ", "\[Sigma]2"}], "+", 
       RowBox[{"6", 
        RowBox[{"\[CapitalSigma]", "[", 
